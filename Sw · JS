// sw.js — Budget Family Service Worker
// מטפל בהתראות Push כשהאפליקציה סגורה לגמרי

self.addEventListener('install', e => {
  self.skipWaiting(); // הפעל מיד בלי לחכות
});

self.addEventListener('activate', e => {
  e.waitUntil(clients.claim()); // השתלט על כל הטאבים מיד
});

// קבלת Push מהשרת
self.addEventListener('push', e => {
  let data = { title: '💰 תקציב משפחתי', body: 'הוצאה חדשה נרשמה' };
  try {
    if (e.data) data = e.data.json();
  } catch (_) {
    if (e.data) data.body = e.data.text();
  }

  e.waitUntil(
    self.registration.showNotification(data.title, {
      body: data.body,
      icon: 'https://cdn.jsdelivr.net/npm/emoji-datasource-apple/img/apple/64/1f4b0.png',
      badge: 'https://cdn.jsdelivr.net/npm/emoji-datasource-apple/img/apple/64/1f514.png',
      dir: 'rtl',
      lang: 'he',
      tag: 'budget-expense',
      renotify: true,
      vibrate: [200, 100, 200],
      data: { url: self.registration.scope }
    })
  );
});

// לחיצה על ההתראה — פתח את האפליקציה
self.addEventListener('notificationclick', e => {
  e.notification.close();
  const url = e.notification.data?.url || self.registration.scope;
  e.waitUntil(
    clients.matchAll({ type: 'window', includeUncontrolled: true }).then(list => {
      for (const client of list) {
        if (client.url.startsWith(self.registration.scope) && 'focus' in client)
          return client.focus();
      }
      if (clients.openWindow) return clients.openWindow(url);
    })
  );
});
